#!/usr/bin/env bash
# Display messages indefinitely and handle signals using a PID file

PIDFILE="/var/run/myscript.pid"

echo "$$" > "$PIDFILE"

cleanup() {
    rm -f "$PIDFILE"
    exit 0
}

handle_term() {
    echo "I hate the kill command"
    cleanup
}

trap 'echo "Y U no love me?!"' SIGINT
trap handle_term SIGTERM
trap cleanup SIGQUIT

while true
do
    echo "To infinity and beyond"
    sleep 2
done
